# ─── PostgreSQL ───
POSTGRES_USER=accounting
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=accounting
POSTGRES_PORT=5432

# ─── Adminer ───
ADMINER_PORT=8080

# ─── API (.NET) ───
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8081

# ─── JWT ───
JWT_SECRET=replace_with_at_least_32_char_random_secret_value_here
JWT_ISSUER=accounting-api
JWT_AUDIENCE=accounting-web
JWT_EXPIRY_MINUTES=60

# ─── Email Service ───
EMAIL_SERVICE_PORT=3001
EMAIL_SERVICE_SECRET=replace_with_random_secret_min_32_chars
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=<YOUR_API_TOKEN>
EMAIL_FROM=Accounting <hello@demomailtrap.co>
APP_URL=http://localhost:3000

# ─── Web (Next.js) ───
NEXT_PUBLIC_API_URL=http://localhost:8081
API_INTERNAL_URL=http://localhost:8081
WEB_PORT=3000
